# Адрес сервера (NestJS на Railway), например https://greek-server.up.railway.app
VITE_API_URL=

# Необязательно: Sentry для ошибок фронтенда
VITE_SENTRY_DSN=

# Только для генерации готового звука (npm run audio:generate) — в сборку не попадает.
# Голоса и модель должны совпадать с настройками сервера.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
