# Postgres (на Railway подставляется автоматически из плагина Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/greek

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Адрес фронтенда (Mini App / PWA), например https://greek-interview.vercel.app
WEBAPP_URL=http://localhost:5173

# Публичный адрес этого сервера для вебхука Telegram.
# На Railway можно не задавать — берётся RAILWAY_PUBLIC_DOMAIN. Без него бот работает в режиме polling.
PUBLIC_URL=

# Дополнительные разрешённые origin для CORS через запятую (WEBAPP_URL разрешён всегда)
ALLOWED_ORIGINS=http://localhost:5173

# Необязательно: VAPID-ключи. Если не заданы — сгенерируются и сохранятся в БД.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

PORT=3000
