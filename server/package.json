{
  "name": "greek-interview-server",
  "private": true,
  "version": "1.0.0",
  "description": "Бэкенд тренажёра: Telegram-бот, напоминания, Web Push",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "typeorm": "typeorm -d dist/data-source.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "migration:run": "npm run build && typeorm -d dist/data-source.js migration:run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/nestjs": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-telegraf": "^2.9.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "telegraf": "^4.16.3",
    "typeorm": "^0.3.31",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
